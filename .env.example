# flower-cache Configuration
# Copy this file to .env and customize as needed

# Server Configuration
# Port number for the HTTP server
PORT=24242

# Seconds a client connection may sit without traffic before Bun closes it.
# Bun's 10s default silently drops any request whose upstream fetch runs
# longer - including the 503/504 the download pool produces - so the caller
# sees a dead socket instead of an answer. Bun caps this at 255.
REQUEST_IDLE_TIMEOUT=120

# Cache Configuration
# Directory where cached blobs are stored
CACHE_DIR=./cache

# Maximum cache size (supports: B, KB, MB, GB, TB)
# When exceeded, least-recently-used blobs are automatically pruned
# Examples: "10GB", "500MB", "1TB", "50GB"
# Leave unset or empty for no size limit
MAX_CACHE_SIZE=

# Network Configuration
# Upstream request timeout in milliseconds (per server attempt)
REQUEST_TIMEOUT=10000

# Time budget for finding an upstream server that has the blob. Bounds the
# worst-case cost of a miss to a constant instead of REQUEST_TIMEOUT x
# (number of candidate servers). Does not cover the transfer itself - see
# DOWNLOAD_STALL_TIMEOUT / DOWNLOAD_MIN_SPEED / DOWNLOAD_MAX_DURATION.
DOWNLOAD_BUDGET=30000

# Abort an upstream transfer that delivers no bytes for this long (ms).
# Without it, a server that sends headers and then goes quiet pins a
# download worker indefinitely.
DOWNLOAD_STALL_TIMEOUT=15000

# Minimum sustained upstream throughput in bytes/sec, enforced once a
# transfer has been running for DOWNLOAD_STALL_TIMEOUT. Catches a drip that
# is slow but too regular to trip the stall timer.
DOWNLOAD_MIN_SPEED=16384

# Hard ceiling (ms) on a single blob transfer regardless of throughput.
DOWNLOAD_MAX_DURATION=1800000

# Number of worker threads used for cache-miss downloads
# Defaults to CPU count when unset
DOWNLOAD_WORKERS=

# Maximum number of downloads that may be queued waiting for a free worker.
# Requests beyond this are answered with 503 so a flood of distinct missing
# hashes can't grow the queue (and upstream fan-out) without bound.
MAX_DOWNLOAD_QUEUE=100

# How long (ms) a download may wait for a free worker before the caller is
# rejected with 503, rather than hanging until the connection dies.
DOWNLOAD_QUEUE_TIMEOUT=30000

# Backstop (ms) covering a download's whole life: queue wait plus execution.
# Workers bound themselves first, so this only fires when one has genuinely
# stopped responding - the caller gets a 504 and the worker is replaced.
# Defaults to DOWNLOAD_BUDGET + DOWNLOAD_MAX_DURATION + 30000 when unset.
DOWNLOAD_JOB_TIMEOUT=

# Delay (ms) before replacing a lost download worker; rate-limits crash loops.
WORKER_RESPAWN_DELAY=1000

# How long (ms) to remember that a blob was not found upstream, so repeat
# requests for the same missing hash get an instant 404 instead of re-hunting
# every upstream server. Set to 0 to disable negative caching.
NEGATIVE_CACHE_TTL=60000

# Maximum number of distinct missing hashes to remember (bounds memory)
NEGATIVE_CACHE_MAX_ENTRIES=10000

# Maximum number of HTTP redirects to follow
MAX_REDIRECTS=5

# Nostr Configuration (BUD-03)
# Timeout for looking up user server lists from Nostr relays (milliseconds)
USER_SERVER_LIST_TIMEOUT=20000

# Comma-separated list of Nostr relay URLs for author server lookup
# Example: wss://relay1.example.com,wss://relay2.example.com
LOOKUP_RELAYS=

# Blossom Server Configuration
# Comma-separated list of Blossom server URLs to try as fallback
# Must include protocol (http:// or https://)
# Example: https://blossom.primal.net,https://cdn.example.com
FALLBACK_SERVERS=

# A common seperated list of allowed IP address allowed to upload and delete
# Examples: "127.0.0.0/8,::1"
ALLOWED_UPLOAD_IPS=
